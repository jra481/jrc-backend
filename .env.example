# Copy to .env for local development. Never commit the real .env file.
DEBUG=True
SECRET_KEY=generate-a-50-plus-character-random-secret-with-many-character-types
ALLOWED_HOSTS=localhost,127.0.0.1
DEPLOYMENT_ALLOWED_HOSTS=localhost,127.0.0.1
# Production must use the exact public API hostname in both allowlist values.
SITE_URL=http://localhost:5173
# Production: exact browser storefront origins only (comma separated); do not
# use * when requests include cookies. Set the public API hostname in
# ALLOWED_HOSTS/DEPLOYMENT_ALLOWED_HOSTS when deploying to AWS EC2.
STOREFRONT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_COOKIE_SAMESITE=Lax
# The production Vercel deployment uses a same-origin /api proxy to EC2, so
# keep this as Lax. Use None only if the browser calls a separate HTTPS API
# hostname directly.
TRUST_PROXY_SSL_HEADER=True

# Production only: Memcached must be reachable by every application worker.
MEMCACHED_LOCATION=127.0.0.1:11211
# Keep the API available during a temporary cache outage. Set false only if
# request throttling must fail closed instead of allowing degraded traffic.
MEMCACHED_IGNORE_EXCEPTIONS=true
# Optional safety net for deployments that start WSGI directly. The AWS EC2
# systemd deployment runs migrations as a separate release step.
RUN_MIGRATIONS_ON_START=true

# Preferred production database: copy the pooled connection string from Neon.
# It normally ends with `?sslmode=require` (and may include
# `channel_binding=require`). Keep this value secret.
# DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Legacy/local MySQL settings. Use these only when DATABASE_URL is unset,
# such as while exporting data from the old MySQL database.
DB_NAME=EEHOOK
DB_USER=root
DB_PASSWORD=replace-with-local-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306

GOOGLE_CLIENT_ID=your-google-oauth-client-id
# Google OAuth and SMTP are separate credentials. For Gmail SMTP, use an App
# Password generated for the sender account, never its normal account password.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=eehook.in@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=eehook.in@gmail.com
EMAIL_TIMEOUT=20
PASSWORD_RESET_TIMEOUT=3600
STRIPE_PUBLISHABLE_KEY=pk_live_replace_me
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
