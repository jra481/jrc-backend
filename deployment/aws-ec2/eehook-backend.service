[Unit]
Description=EEHOOK Django API
Wants=network-online.target
After=network-online.target memcached.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/eehook-backend
EnvironmentFile=/etc/eehook-backend.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/eehook-backend/.venv/bin/gunicorn \
    --bind 127.0.0.1:8000 \
    --workers 2 \
    --threads 2 \
    --timeout 120 \
    --access-logfile - \
    --error-logfile - \
    myproject.wsgi:application
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGQUIT
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
